# Kopiera till .env (gitignorerad). Nycklar läggs aldrig i koden eller i chatten.
# Lokalt bygge mot tillfällig adress:
NOINDEX=1
# SITE_URL=https://<projekt>.kinsta.page
# KONTAKT_URL=https://<kontakttjänst>.sevalla.app/kontakt
# Sökväg till Chrome/Edge för npm run mat om den inte hittas själv:
# MAT_WEBBLASARE=
