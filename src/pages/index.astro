---
// Startsidan. Texter: drafts/texter/2026-10-21-rostprov.md. Riktning B (godkänd 2026-10-21).
import Bas from '../layouts/Bas.astro';
import Bild from '../components/Bild.astro';
import Forfragan from '../components/Forfragan.astro';
import Markisraknare from '../components/Markisraknare.astro';
import HelsingborgKarta from '../components/HelsingborgKarta.astro';
import { SAJT, telLank } from '../data/sajt';
import { ihop } from '../lib/text';
import { tjanst, faq } from '../lib/schema';

const KORT = [
  { bild: 'terrassmarkis-middag', rubrik: 'Terrassmarkiser', text: 'Skugga över altan och uteplats, med vev eller motor. Upp till sju meter bred i en sektion.', url: '/terrassmarkiser/' },
  { bild: 'fonstermarkis-fallarm', rubrik: 'Fönstermarkiser', text: 'Håller värmen ute innan den når glaset. Fallarm, korgmarkis eller markisolett.', url: '/fonstermarkiser/' },
  { bild: 'vertikalmarkis-zip', rubrik: 'Vertikalmarkiser', text: 'Screen framför stora glaspartier och inglasade uterum.', url: '/vertikalmarkiser/' },
  { bild: 'pergola-foretag-led', rubrik: 'Pergolamarkiser', text: 'Ett eget tak över uteplatsen, med väv som rullas ut när solen ligger på.', url: '/pergolamarkiser/' },
  { bild: 'terrassmarkis-villa', rubrik: 'Ny väv på din markis', text: 'Byt bara väven när stommen fortfarande håller. Vi gör det på alla fabrikat.', url: '/markisvav/' },
  { bild: 'persienn-sovrum', rubrik: 'Invändigt solskydd', text: 'Persienner, rullgardiner, plissé- och lamellgardiner, måttbeställda till dina fönster.', url: '/persienner/' },
];
const STEG = [
  ['Du skickar en förfrågan', 'Berätta vad du är intresserad av. Mått behövs inte.'],
  ['Vi ringer upp samma dag', 'och bokar en tid för hembesök som passar dig.'],
  ['Hembesöket', 'Vi mäter, tittar på fasaden och hur solen ligger. Du väljer väv från riktiga prover.'],
  ['Offert', 'Du får ett skriftligt förslag. Inget är bindande innan du har sagt ja.'],
  ['Montering', 'En terrassmarkis sätts oftast upp på några timmar.'],
];
const GUIDER = [
  { rubrik: 'Hur högt ska en markis sitta?', url: '/guider/hur-hogt-ska-en-markis-sitta/' },
  { rubrik: 'Byta motor på markisen', url: '/guider/byta-markismotor/' },
  { rubrik: 'Så tvättar du markisväven', url: '/guider/tvatta-markis/' },
];
const OMRADEN = ['Centrum', 'Norr', 'Tågaborg', 'Olympia', 'Ramlösa', 'Råå', 'Påarp', 'Rydebäck', 'Hittarp', 'Laröd', 'Domsten', 'Ödåkra', 'Mörarp', 'Allerum', 'Kattarp', 'Bårslöv'];
const FRAGOR = [
  { fraga: 'Kostar hembesöket något?', svar: 'Nej. Vi mäter och ger en offert utan kostnad, och du bestämmer dig efteråt.' },
  { fraga: 'Vad kostar en markis?', svar: 'Det beror på bredd, utfall, väv och om den ska ha motor. Därför lämnar vi pris efter hembesöket, när vi vet vad som passar ditt hus.' },
  { fraga: 'Behöver jag veta måtten innan jag hör av mig?', svar: 'Nej. Det räcker att du berättar ungefär var markisen ska sitta. Vill du skicka med en bild av fasaden går det snabbare.' },
  { fraga: 'Kan jag få motor och fjärrkontroll?', svar: 'Ja, de flesta markiser kan fås med motor och styras med fjärrkontroll eller app.' },
  { fraga: 'Ni har ingen butik i Helsingborg. Hur fungerar det?', svar: 'Vi kommer till dig. Kontoret ligger i Ängelholm, och vi gör hembesök och monteringar i hela Helsingborg.' },
];
---
<Bas
  titel="Markiser i Helsingborg med hembesök | Markiser Helsingborg"
  beskrivning="Terrassmarkiser, fönstermarkiser och invändigt solskydd i Helsingborg. Svensktillverkat från Hestra, kostnadsfritt hembesök och uppringning samma dag."
  bild="startsida-hero-terrassmarkis"
  schema={[tjanst({ url: SAJT.url + '/', namn: 'Markiser och solskydd i Helsingborg', beskrivning: 'Försäljning och montering av markiser och solskydd med kostnadsfritt hembesök i Helsingborg.', orter: ['Helsingborg'] }), faq(FRAGOR)]}
>
  <section class="hero">
    <div class="inre hero-inre">
      <div class="hero-text">
        <p class="eyebrow">Markiser och solskydd i Helsingborg</p>
        <h1>Markiser i Helsingborg<span class="sr">,</span> <span class="h1-under">uppmätta hemma hos dig</span></h1>
        <p class="ingress">{ihop('Vi mäter, visar vävprover på plats och monterar. Markiserna är svensktillverkade av Hestra Markis och vävarna kommer från Sandatex. Skicka en förfrågan, så ringer vi upp samma dag.')}</p>
        <ul class="bockar">
          <li>Hembesök utan kostnad</li>
          <li>Svensktillverkat av Hestra</li>
          <li>Väv från Sandatex</li>
        </ul>
        <p class="hero-tel">Hellre prata direkt? Ring <a href={telLank(SAJT.telefon)} data-placering="hero">{SAJT.telefon}</a></p>
      </div>
      <div class="hero-hoger">
        <Bild namn="startsida-hero-terrassmarkis" alt="Terrassmarkis i grått över en altan med trädgårdsmöbler vid en vit villa med tegeltak" sizes="(max-width: 820px) 100vw, 560px" prioritet class="hero-foto" />
        <Forfragan />
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="inre">
      <div class="sek-huvud">
        <h2>{ihop('Det här kan vi hjälpa dig med')}</h2>
        <p>{ihop('Allt måttbeställs efter ditt hus. Vi visar alternativen vid hembesöket.')}</p>
      </div>
      <div class="kortnat">
        {KORT.map(k => (
          <a class="kort" href={k.url}>
            <Bild namn={k.bild} alt="" sizes="(max-width: 700px) 100vw, 380px" />
            <span class="kort-text">
              <span class="kort-rubrik">{k.rubrik}</span>
              <span class="kort-brod">{ihop(k.text)}</span>
              <span class="kort-lank">Läs mer</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="inre">
      <div class="sek-huvud">
        <h2>Så går det till</h2>
        <p>{ihop('Från första kontakt till färdig markis på fasaden.')}</p>
      </div>
      <ol class="steglista">
        {STEG.map(([r, t], i) => <li><span class="steg-nr" aria-hidden="true">{i + 1}</span><h3>{r}</h3><p>{ihop(t)}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sektion">
    <div class="inre"><div class="raknare-ram">
      <div class="sek-huvud">
        <h2>{ihop('Hur stor markis behöver du?')}</h2>
        <p>{ihop('En terrassmarkis bör vara 20–30 centimeter bredare än ytan du vill ha i skugga, så att skuggan räcker även när solen står snett. Fyll i ungefärliga mått, så får du en första uppskattning.')}</p>
      </div>
      <Markisraknare /></div>
    </div>
  </section>

  <section class="sektion">
    <div class="inre delad">
      <div class="delad-text">
        <h2>{ihop('Varför det spelar roll var i Helsingborg du bor')}</h2>
        <p>Vid sundet blåser det mer än inne i landet, och en markis i västerläge får eftermiddagssolen rakt in från vattnet. I villaområdena på Tågaborg och Ramlösa sitter markisen ofta på en putsad eller tegelklädd fasad med äldre fönsterkarmar, medan nyare hus på till exempel Norr har stora glaspartier som passar bättre för vertikalmarkiser.</p>
        <p>Det är sådant vi tittar på vid hembesöket, och därför ger vi inga priser innan vi har sett huset.</p>
        <h3 class="omraden-rubrik">Vi gör hembesök i hela Helsingborg</h3>
        <ul class="chips">{OMRADEN.map(o => <li>{o}</li>)}</ul>
      </div>
      <HelsingborgKarta />
    </div>
  </section>

  <section class="sektion">
    <div class="inre delad">
      <Bild namn="pergola-foretag-fasad" alt="Pergolamarkis med träbänkar framför en grå kontorsfasad" sizes="(max-width: 820px) 100vw, 560px" class="delad-bild" />
      <div class="delad-text">
        <h2>Vilka vi är</h2>
        <p>Markiser Helsingborg drivs av Markisbyrån Sverige AB, som säljer och monterar solskydd i nordvästra Skåne från Ängelholm. Det är samma personer som svarar i telefon, mäter hos dig och monterar.</p>
        <p>Vi gör också service och reparation på markiser vi inte har sålt, och byter väv på alla fabrikat.</p>
        <p><a class="knapp-2" href="/om-oss/">Mer om oss</a></p>
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="inre">
      <div class="sek-huvud">
        <h2>{ihop('Guider innan du bestämmer dig')}</h2>
      </div>
      <ul class="guidelista">
        {GUIDER.map(g => <li><a href={g.url}>{g.rubrik}</a></li>)}
        <li><a href="/guider/">Alla guider</a></li>
      </ul>
    </div>
  </section>

  <section class="sektion">
    <div class="inre">
      <div class="sek-huvud"><h2>Vanliga frågor</h2></div>
      <div class="fragor">
        {FRAGOR.map(f => <details><summary>{f.fraga}</summary><div><p>{ihop(f.svar)}</p></div></details>)}
      </div>
    </div>
  </section>

  <section class="sektion sektion-petrol">
    <div class="inre avslut-inre">
      <h2>{ihop('Vill du ha skugga till våren?')}</h2>
      <p>{ihop('Hör av dig nu, så hinner vi mäta och montera före säsongen.')}</p>
      <div class="knappar"><a class="knapp" href="#forfragan">Boka hembesök</a><a class="knapp-2" href={telLank(SAJT.telefon)} data-placering="avslut">Ring {SAJT.telefon}</a></div>
    </div>
  </section>
</Bas>
