---
// Kontakt- och offertformulär. Sajten är statisk: formuläret postar till kontakttjänsten (tjanster/kontakt),
// som mejlar via Brevo och skickar besökaren till /tack/. Fälten "webbplats" (robotfälla) och samtycket krävs
// (npm run kontroll). Extra fält skickas med i mejlet som de är.
import EnkelSida from '../components/EnkelSida.astro';
import Forfragan from '../components/Forfragan.astro';
import { SAJT, telLank } from '../data/sajt';
---
<EnkelSida titel="Boka kostnadsfritt hembesök" seoTitel="Kontakt och hembesök" beskrivning="Boka ett kostnadsfritt hembesök i Helsingborg. Skicka en förfrågan så ringer vi upp samma dag, eller ring 0431-199 77 direkt." ingress="Berätta vad du är intresserad av, så ringer vi upp samma dag och bokar en tid för hembesök.">
  {SAJT.telefon && <p>Vill du hellre prata? Ring <a href={telLank(SAJT.telefon)} data-placering="kontakt">{SAJT.telefon}</a>.</p>}
  <Forfragan id="kontakt" rubrik="Din förfrågan" />
</EnkelSida>
