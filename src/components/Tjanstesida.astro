---
// Tjänste- och produktsida (förebild: redovisningsföretag.se/redovisningskonsult/): hero med formulär,
// faktaband, brödtext med innehållsförteckning i sidospalten, tabell, checklista, steg, räknare, frågor,
// källor, länklistor och formuläret igen sist.
import Bas from '../layouts/Bas.astro';
import Brodsmulor from './Brodsmulor.astro';
import HeroForm from './HeroForm.astro';
import Innehallsforteckning from './Innehallsforteckning.astro';
import Block from './Block.astro';
import Fragor from './Fragor.astro';
import Relaterade from './Relaterade.astro';
import Avslut from './Avslut.astro';
import Markisraknare from './Markisraknare.astro';
import { SAJT, telLank } from '../data/sajt';
import { ihop } from '../lib/text';
import { brodsmulor, tjanst, faq } from '../lib/schema';
import { namn, sida as hamta, type Sida, type Rubrik } from '../lib/innehall';
interface Props { sida: Sida; rubriker?: Rubrik[] }
const { sida, rubriker = [] } = Astro.props;
const foralder = sida.forelder ? hamta(sida.forelder) : undefined;
const smulor = [{ namn: 'Start', url: '/' }, ...(foralder ? [{ namn: namn(foralder), url: foralder.url }] : []), { namn: namn(sida), url: sida.url }];
const schema = [brodsmulor(smulor), tjanst({ url: sida.url, namn: sida.titel, beskrivning: sida.beskrivning, orter: ['Helsingborg'] }), ...(sida.fragor?.length ? [faq(sida.fragor)] : [])];
---
<Bas titel={sida.seoTitel ?? sida.titel} beskrivning={sida.beskrivning} bild={sida.bild} schema={schema}>
  <HeroForm bild={sida.bild} bildAlt={sida.bildAlt} produkt={sida.produkt} bockar={sida.bockar}>
    <Brodsmulor smulor={smulor} />
    <p class="eyebrow">{sida.typ === 'hubb' ? 'Översikt' : 'I Helsingborg'}</p>
    <h1>{ihop(sida.titel)}</h1>
    <p class="ingress">{ihop(sida.ingress)}</p>
  </HeroForm>

  {sida.fakta?.length && (
    <section class="faktaband" aria-label="I korthet">
      <div class="inre"><dl class="faktaband-rad">{sida.fakta.map(f => <div><dt>{f.namn}</dt><dd>{f.varde}</dd></div>)}</dl></div>
    </section>
  )}

  <section class="sektion">
    <div class="inre las-layout">
      <aside class="las-sida">
        <Innehallsforteckning rubriker={rubriker} variant="sida" />
        <div class="cta-kort">
          <p class="cta-kort-rubrik">{ihop('Kostnadsfritt hembesök')}</p>
          <p>{ihop('Vi mäter, visar vävprover och ringer upp samma dag.')}</p>
          <a class="knapp" href="#forfragan">Boka hembesök</a>
          <a class="cta-tel" href={telLank(SAJT.telefon)} data-placering="sidospalt">{SAJT.telefon}</a>
        </div>
      </aside>
      <div class="brod prosa"><slot /></div>
    </div>
  </section>

  <slot name="efter" />
  <Block sida={sida} visa="tabell" />
  <Block sida={sida} visa="checklista" />
  {sida.raknare && (
    <section class="sektion">
      <div class="inre"><div class="raknare-ram">
        <div class="sek-huvud"><h2>{ihop('Räkna ut ungefärlig storlek')}</h2><p>{ihop('Fyll i ytans bredd och hur långt ut skuggan ska nå, så får du en första uppskattning av markisens mått.')}</p></div>
        <Markisraknare />
      </div></div>
    </section>
  )}
  <Block sida={sida} visa="steg" />
  <Fragor fragor={sida.fragor ?? []} />
  <Relaterade urler={sida.relaterade ?? []} />
  {sida.typ !== 'hubb' && <Block sida={sida} visa="lankar" />}
  <Block sida={sida} visa="kallor" />
  <Avslut produkt={sida.produkt} />
</Bas>
