---
// Hero med bild och förfrågan i tre steg (samma upplägg som startsidan).
import Bild from './Bild.astro';
import Forfragan from './Forfragan.astro';
import { SAJT, telLank, BOCKAR } from '../data/sajt';
interface Props { bild?: string; bildAlt?: string; produkt?: string; bockar?: string[] }
const { bild, bildAlt = '', produkt, bockar = BOCKAR } = Astro.props;
---
<section class="hero">
  <div class="inre hero-inre">
    <div class="hero-text">
      <slot />
      <ul class="bockar">{bockar.map(b => <li>{b}</li>)}</ul>
      <p class="hero-tel">Hellre prata direkt? Ring <a href={telLank(SAJT.telefon)} data-placering="hero">{SAJT.telefon}</a></p>
    </div>
    <div class={`hero-hoger${bild ? '' : ' utan-foto'}`}>
      {bild && <Bild namn={bild} alt={bildAlt} sizes="(max-width: 820px) 100vw, 560px" prioritet class="hero-foto" />}
      <Forfragan produkt={produkt} />
    </div>
  </div>
</section>
